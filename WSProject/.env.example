# Copy this file to .env.local and fill in the values. Never commit .env.local.

# MongoDB. Local Docker (docker compose up -d) or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27018/wheelspace

# Admin account (single admin for the demo).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Random string of at least 32 characters, used to sign the admin session cookie.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Public base URL of the site (no trailing slash). Used for the Google login redirect.
APP_URL=http://localhost:3000

# Google login for customers (Google Cloud Console > APIs & Services > Credentials > OAuth client ID).
# Authorized redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Third-party providers. Free dev defaults; paid options are listed in docs/THIRD_PARTY_SERVICES.md.
STORAGE_PROVIDER=local
EMAIL_PROVIDER=console
SMS_PROVIDER=console

# Payment: "mock" simulates payOS locally; "payos" uses the real API.
PAYMENT_PROVIDER=mock
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
