{
  "name": "wheelspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "check:oauth": "node --conditions=react-server --import tsx scripts/check-google-oauth.ts",
    "check:accounts": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/check-accounts.ts"
  },
  "dependencies": {
    "mongoose": "^9.13.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
